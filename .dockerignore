# Build context for the Modal preview image (see modal_app.py).
#
# .git must be excluded: git touches .git/index while Modal is hashing the
# context, and Modal aborts the build with "was modified during build process".
# Everything else here just keeps the upload small.

.git
.github
.vs
.dockerignore
Dockerfile
modal_app.py
deploy.log

**/bin/
**/obj/
**/*.user
**/*.suo
