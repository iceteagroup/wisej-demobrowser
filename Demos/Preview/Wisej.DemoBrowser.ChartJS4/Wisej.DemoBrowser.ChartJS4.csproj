<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net48;net10.0</TargetFrameworks>
	<PlatformTarget>AnyCPU</PlatformTarget>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
	<NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))'=='net'">
	<Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Chart.js_logo.svg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Chart.js_logo.svg" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Wisej-4" Version="4.1.*-*" />
	<PackageReference Include="Wisej-4-FluentUIFilledIcons" Version="4.1.*-*" />
	<ProjectReference Include="..\..\..\Wisej.DemoBrowser.Common\Wisej.DemoBrowser.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Compile Update="Features.cs">
	  <SubType>UserControl</SubType>
	</Compile>
	<Compile Update="Features.cs">
	  <SubType>UserControl</SubType>
	</Compile>
  </ItemGroup>

</Project>
